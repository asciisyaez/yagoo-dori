{
  "name": "yagoo-dori",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @yagoo-dori/web dev",
    "build": "pnpm assets:check && pnpm data:validate && pnpm --filter @yagoo-dori/web build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/serve-pages-export.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @yagoo-dori/core test",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "data:validate": "pnpm --filter @yagoo-dori/core data:validate",
    "rankings:generate": "pnpm --filter @yagoo-dori/core rankings:generate",
    "guides:generate": "pnpm --filter @yagoo-dori/core guides:generate",
    "guides:rebase": "pnpm --filter @yagoo-dori/core guides:rebase",
    "data:sync": "pnpm data:sync:public && pnpm data:sync:mechanics && pnpm data:sync:songs && pnpm data:sync:timelines",
    "data:sync:public": "node scripts/sync-public-data.mjs",
    "data:sync:mechanics": "node scripts/sync-mechanics-data.mjs",
    "data:sync:songs": "node scripts/sync-song-data.mjs",
    "data:sync:timelines": "pnpm --filter @yagoo-dori/core timelines:sync && pnpm --filter @yagoo-dori/core timelines:project && pnpm --filter @yagoo-dori/core timelines:project:guides",
    "assets:previews": "node scripts/generate-art-previews.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "project:status": "node scripts/project-status.mjs",
    "optimizer:scope": "node scripts/generate-exact-optimizer-scope.mjs",
    "optimizer:parity:ir": "node scripts/generate-exact-optimizer-parity-ir.mjs",
    "optimizer:parity": "node --import tsx/esm scripts/run-exact-parity-harness.mjs",
    "optimizer:parity:diagnostic": "node --import tsx/esm scripts/run-exact-parity-diagnostic.mjs",
    "optimizer:benchmark": "node --import tsx/esm scripts/benchmark-exact-optimizer-formulations.mjs",
    "optimizer:aggregation:benchmark": "node --import tsx/esm scripts/benchmark-exact-leader-resolution-aggregation.mjs",
    "optimizer:parity:compiled": "node scripts/run-exact-compiled-parity.mjs",
    "optimizer:parity:rust-fixtures": "node scripts/run-exact-rust-mechanic-fixtures.mjs",
    "optimizer:parity:reduced": "node --import tsx/esm scripts/run-exact-reduced-bruteforce.mjs",
    "optimizer:metamorphic": "node --import tsx/esm scripts/run-exact-metamorphic.mjs",
    "optimizer:shards:fixture": "node scripts/generate-exact-shard-fixture.mjs",
    "optimizer:shards:plan": "node --import tsx/esm scripts/generate-exact-full-shard-plan.mjs",
    "optimizer:shards:plan:verify": "node --import tsx/esm scripts/verify-exact-shard-plan.mjs data/native/exact-optimizer-full-shard-plan-v1.json",
    "optimizer:shards:reduced": "node --import tsx/esm scripts/run-exact-reduced-shards.mjs",
    "optimizer:shards:verify:reduced": "node scripts/verify-exact-shards.mjs data/native/exact-optimizer-reduced-shard-run-v1.json --replay-reduced",
    "optimizer:shards:verify": "node scripts/verify-exact-shards.mjs data/native/exact-optimizer-shard-fixture-v1.json",
    "optimizer:shards:determinism": "node scripts/test-exact-shard-determinism.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
